{
  "name": "pici",
  "version": "4.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pici": "dist/index.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"{src,test}/**/*.{ts,json}\"",
    "format:check": "prettier --check \"{src,test}/**/*.{ts,json}\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "verify": "yarn lint && yarn format:check && yarn typecheck && yarn test:coverage",
    "prepublishOnly": "yarn verify && yarn build"
  },
  "repository": "git@github.com:tamasmagyar/pici.git",
  "author": "Tamas Magyar",
  "license": "MIT",
  "keywords": [
    "cli",
    "dependencies",
    "selective install",
    "package manager",
    "npm",
    "yarn",
    "ci",
    "cd",
    "devtools",
    "playwright",
    "minimal",
    "automation"
  ],
  "description": "Minimal CLI to install a subset of dependencies from your main package.json.",
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8",
    "vitest": "^5.1.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
